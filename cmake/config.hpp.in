/**
 * @brief Maximum number of variadic arguments supported by TRLC macros
 * 
 * This value is set at CMake configuration time via TRLC_VARIADIC_MACRO_LIMIT.
 * Default is 64 if not specified.
 * 
 * All variadic macros (TRLC_COUNT, TRLC_FOREACH_*, TRLC_CONCAT) support up to this many arguments.
 */
constexpr int VARIADIC_MACRO_LIMIT = @TRLC_VARIADIC_MACRO_LIMIT@;

